{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Vigasoco",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/VigasocoSDL/vigasoco",
            "args": ["abadia"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/VigasocoSDL",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Vigasoco",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}